module hamming_74_encoder (
    input  wire [3:0] data,
    output wire [6:0] codeword
);

    wire p1, p2, p4;

    // Parity bit calculations
    assign p1 = data[0] ^ data[1] ^ data[3];
    assign p2 = data[0] ^ data[2] ^ data[3];
    assign p4 = data[1] ^ data[2] ^ data[3];

    // Hamming (7,4) format:
    // Position:  1   2   3   4   5   6   7
    //            P1  P2  D1  P4  D2  D3  D4

    assign codeword = {
        data[3],  // D4
        data[2],  // D3
        data[1],  // D2
        p4,       // P4
        data[0],  // D1
        p2,       // P2
        p1        // P1
    };

endmodule
