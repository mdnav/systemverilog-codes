module i2s_transmitter (
    input  wire        CLK,
    input  wire        RESET,

    input  wire        START,
    input  wire [15:0] LEFT_DATA,
    input  wire [15:0] RIGHT_DATA,

    output reg         I2S_SCK,
    output reg         I2S_WS,
    output reg         I2S_SD,

    output reg         BUSY,
    output reg         DONE
);

    reg [15:0] left_reg;
    reg [15:0] right_reg;

    reg [5:0] bit_count;

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            I2S_SCK <= 1'b0;
            I2S_WS  <= 1'b0;
            I2S_SD  <= 1'b0;

            left_reg  <= 16'd0;
            right_reg <= 16'd0;

            bit_count <= 6'd0;

            BUSY <= 1'b0;
            DONE <= 1'b0;
        end
        else begin
            DONE <= 1'b0;

            if (START && !BUSY) begin
                left_reg  <= LEFT_DATA;
                right_reg <= RIGHT_DATA;

                bit_count <= 6'd0;

                BUSY <= 1'b1;
                I2S_WS <= 1'b0;
                I2S_SCK <= 1'b0;

                I2S_SD <= LEFT_DATA[15];
            end
            else if (BUSY) begin

                I2S_SCK <= ~I2S_SCK;

                // Change data on falling edge
                if (I2S_SCK == 1'b1) begin

                    if (bit_count < 16) begin
                        I2S_WS <= 1'b0;
                        I2S_SD <= left_reg[15 - bit_count];
                    end
                    else begin
                        I2S_WS <= 1'b1;
                        I2S_SD <= right_reg[15 - (bit_count - 16)];
                    end

                    if (bit_count == 6'd31) begin
                        BUSY <= 1'b0;
                        DONE <= 1'b1;
                        I2S_SD <= 1'b0;
                    end
                    else begin
                        bit_count <= bit_count + 1'b1;
                    end

                end
            end
        end
    end

endmodule
