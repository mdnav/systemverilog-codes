// tb_logic_gates.v

`timescale 1ns/1ps

module tb_logic_gates;

    // Testbench inputs
    reg A;
    reg B;

    // Testbench outputs
    wire AND_out;
    wire OR_out;
    wire NOT_A;
    wire NAND_out;
    wire NOR_out;
    wire XOR_out;
    wire XNOR_out;

    // Instantiate the Design Under Test (DUT)
    logic_gates DUT (
        .A(A),
        .B(B),
        .AND_out(AND_out),
        .OR_out(OR_out),
        .NOT_A(NOT_A),
        .NAND_out(NAND_out),
        .NOR_out(NOR_out),
        .XOR_out(XOR_out),
        .XNOR_out(XNOR_out)
    );

    // Apply test inputs
    initial begin

        // Display header
        $display("---------------------------------------------------------------");
        $display(" A B | AND OR NOT NAND NOR XOR XNOR");
        $display("---------------------------------------------------------------");

        // Monitor output whenever a value changes
        $monitor(" %b %b |  %b   %b   %b    %b    %b   %b    %b",
                 A, B,
                 AND_out,
                 OR_out,
                 NOT_A,
                 NAND_out,
                 NOR_out,
                 XOR_out,
                 XNOR_out);

        // Test Case 1
        A = 0;
        B = 0;
        #10;

        // Test Case 2
        A = 0;
        B = 1;
        #10;

        // Test Case 3
        A = 1;
        B = 0;
        #10;

        // Test Case 4
        A = 1;
        B = 1;
        #10;

        $display("---------------------------------------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
