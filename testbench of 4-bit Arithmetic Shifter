`timescale 1ns/1ps

module tb_arithmetic_shifter_4bit;

    reg  [3:0] DATA;
    reg  [1:0] SHIFT;
    reg        LEFT_RIGHT;

    wire [3:0] RESULT;

    arithmetic_shifter_4bit DUT (
        .DATA(DATA),
        .SHIFT(SHIFT),
        .LEFT_RIGHT(LEFT_RIGHT),
        .RESULT(RESULT)
    );

    initial begin

        $monitor(
            "Time=%0t | DATA=%b | SHIFT=%d | LEFT_RIGHT=%b | RESULT=%b",
            $time, DATA, SHIFT, LEFT_RIGHT, RESULT
        );

        // Positive number: 0100 = +4
        DATA = 4'b0100;
        SHIFT = 2'd1;
        LEFT_RIGHT = 1'b0;
        #10;

        // Negative number: 1100 = -4
        DATA = 4'b1100;
        SHIFT = 2'd1;
        LEFT_RIGHT = 1'b0;
        #10;

        SHIFT = 2'd2;
        #10;

        // Arithmetic left shift
        DATA = 4'b0011;
        SHIFT = 2'd1;
        LEFT_RIGHT = 1'b1;
        #10;

        $finish;

    end

endmodule
