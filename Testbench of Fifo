`timescale 1ns/1ps

module tb_fifo;

    reg CLK;
    reg RESET;
    reg WRITE_EN;
    reg READ_EN;
    reg [7:0] DATA_IN;

    wire [7:0] DATA_OUT;
    wire FULL;
    wire EMPTY;

    fifo #(
        .DATA_WIDTH(8),
        .DEPTH(8)
    ) DUT (
        .CLK(CLK),
        .RESET(RESET),
        .WRITE_EN(WRITE_EN),
        .READ_EN(READ_EN),
        .DATA_IN(DATA_IN),
        .DATA_OUT(DATA_OUT),
        .FULL(FULL),
        .EMPTY(EMPTY)
    );

    // Clock generation
    always #5 CLK = ~CLK;

    initial begin
        CLK = 0;
        RESET = 1;
        WRITE_EN = 0;
        READ_EN = 0;
        DATA_IN = 0;

        #10 RESET = 0;

        // Write 10
        #10;
        WRITE_EN = 1;
        DATA_IN = 8'd10;

        #10 DATA_IN = 8'd20;
        #10 DATA_IN = 8'd30;
        #10 DATA_IN = 8'd40;

        WRITE_EN = 0;

        // Read data
        #10 READ_EN = 1;
        #10;
        #10;
        #10;
        #10;

        READ_EN = 0;

        #20 $finish;
    end

    initial begin
        $monitor("Time=%0t | Write=%b Read=%b Data_In=%d Data_Out=%d Full=%b Empty=%b",
                 $time, WRITE_EN, READ_EN, DATA_IN, DATA_OUT, FULL, EMPTY);
    end

endmodule
