`timescale 1ns/1ps

module tb_carry_lookahead_adder_4bit;

    reg  [3:0] A;
    reg  [3:0] B;
    reg        CIN;

    wire [3:0] SUM;
    wire       COUT;

    carry_lookahead_adder_4bit DUT (
        .A(A),
        .B(B),
        .CIN(CIN),
        .SUM(SUM),
        .COUT(COUT)
    );

    initial begin

        $monitor(
            "Time=%0t | A=%b | B=%b | CIN=%b | SUM=%b | COUT=%b",
            $time, A, B, CIN, SUM, COUT
        );

        A = 4'b0000;
        B = 4'b0000;
        CIN = 1'b0;
        #10;

        A = 4'b0011;
        B = 4'b0101;
        CIN = 1'b0;
        #10;

        A = 4'b0111;
        B = 4'b0001;
        CIN = 1'b0;
        #10;

        A = 4'b1010;
        B = 4'b0101;
        CIN = 1'b0;
        #10;

        A = 4'b1111;
        B = 4'b0001;
        CIN = 1'b0;
        #10;

        A = 4'b1111;
        B = 4'b1111;
        CIN = 1'b1;
        #10;

        $finish;
    end

endmodule
