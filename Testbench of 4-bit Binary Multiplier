`timescale 1ns/1ps

module tb_binary_multiplier_4bit;

    reg  [3:0] A;
    reg  [3:0] B;
    wire [7:0] PRODUCT;

    binary_multiplier_4bit DUT (
        .A(A),
        .B(B),
        .PRODUCT(PRODUCT)
    );

    initial begin

        $monitor(
            "Time=%0t | A=%d | B=%d | PRODUCT=%d | Binary Product=%b",
            $time, A, B, PRODUCT, PRODUCT
        );

        A = 4'd0;
        B = 4'd5;
        #10;

        A = 4'd2;
        B = 4'd3;
        #10;

        A = 4'd5;
        B = 4'd4;
        #10;

        A = 4'd7;
        B = 4'd6;
        #10;

        A = 4'd9;
        B = 4'd8;
        #10;

        A = 4'd12;
        B = 4'd10;
        #10;

        A = 4'd15;
        B = 4'd15;
        #10;

        $finish;

    end

endmodule
