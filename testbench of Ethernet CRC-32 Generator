`timescale 1ns/1ps

module tb_ethernet_crc32;

    reg CLK;
    reg RESET;
    reg DATA_VALID;
    reg [7:0] DATA_IN;

    wire [31:0] CRC;

    ethernet_crc32 uut (
        .CLK(CLK),
        .RESET(RESET),
        .DATA_VALID(DATA_VALID),
        .DATA_IN(DATA_IN),
        .CRC(CRC)
    );

    always #5 CLK = ~CLK;

    task send_byte;
        input [7:0] data;
        begin
            @(negedge CLK);
            DATA_IN = data;
            DATA_VALID = 1;

            @(negedge CLK);
            DATA_VALID = 0;
        end
    endtask

    initial begin
        CLK = 0;
        RESET = 1;
        DATA_VALID = 0;
        DATA_IN = 0;

        #20 RESET = 0;

        send_byte(8'h12);
        send_byte(8'h34);
        send_byte(8'h56);
        send_byte(8'h78);

        #20;

        $display("CRC = %h", CRC);

        $finish;
    end

endmodule
