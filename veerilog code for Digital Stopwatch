module digital_stopwatch #(
    parameter CLK_FREQ = 10
)(
    input  wire       CLK,
    input  wire       RESET,
    input  wire       START,
    input  wire       STOP,

    output reg [5:0]   SECONDS,
    output reg [5:0]   MINUTES,
    output reg         RUNNING
);

    reg [31:0] clk_count;

    // Start / Stop control
    always @(posedge CLK or posedge RESET) begin
        if (RESET)
            RUNNING <= 1'b0;
        else begin
            if (START)
                RUNNING <= 1'b1;
            else if (STOP)
                RUNNING <= 1'b0;
        end
    end

    // Stopwatch counter
    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            clk_count <= 0;
            SECONDS   <= 0;
            MINUTES   <= 0;
        end
        else if (RUNNING) begin

            if (clk_count == CLK_FREQ - 1) begin
                clk_count <= 0;

                if (SECONDS == 59) begin
                    SECONDS <= 0;

                    if (MINUTES == 59)
                        MINUTES <= 0;
                    else
                        MINUTES <= MINUTES + 1'b1;

                end
                else begin
                    SECONDS <= SECONDS + 1'b1;
                end

            end
            else begin
                clk_count <= clk_count + 1'b1;
            end

        end
    end

endmodule
