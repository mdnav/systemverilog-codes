// comparator_4bit.v Behavioral Modeling

module comparator_4bit (
    input [3:0] A,
    input [3:0] B,
    output reg A_greater_B,
    output reg A_equal_B,
    output reg A_less_B
);

    always @(*) begin

        // Default values
        A_greater_B = 0;
        A_equal_B   = 0;
        A_less_B    = 0;

        if (A > B)
            A_greater_B = 1;

        else if (A == B)
            A_equal_B = 1;

        else
            A_less_B = 1;

    end

endmodule
