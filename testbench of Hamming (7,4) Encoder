`timescale 1ns/1ps

module tb_hamming_74_encoder;

    reg [3:0] data;
    wire [6:0] codeword;

    hamming_74_encoder uut (
        .data(data),
        .codeword(codeword)
    );

    initial begin

        $monitor("Time=%0t | Data=%b | Hamming Code=%b",
                 $time, data, codeword);

        data = 4'b0000;
        #10;

        data = 4'b0001;
        #10;

        data = 4'b0010;
        #10;

        data = 4'b0101;
        #10;

        data = 4'b1010;
        #10;

        data = 4'b1111;
        #10;

        $finish;
    end

endmodule
