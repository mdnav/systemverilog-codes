`timescale 1ns/1ps

module tb_excess3_converter;

    reg  [3:0] BCD;
    wire [3:0] EXCESS3;

    excess3_converter DUT (
        .BCD(BCD),
        .EXCESS3(EXCESS3)
    );

    initial begin

        $monitor(
            "Time=%0t | BCD=%b | Excess-3=%b",
            $time, BCD, EXCESS3
        );

        BCD = 4'b0000;  // 0
        #10;

        BCD = 4'b0001;  // 1
        #10;

        BCD = 4'b0010;  // 2
        #10;

        BCD = 4'b0011;  // 3
        #10;

        BCD = 4'b0100;  // 4
        #10;

        BCD = 4'b0101;  // 5
        #10;

        BCD = 4'b0110;  // 6
        #10;

        BCD = 4'b0111;  // 7
        #10;

        BCD = 4'b1000;  // 8
        #10;

        BCD = 4'b1001;  // 9
        #10;

        $finish;
    end

endmodule
