`timescale 1ns/1ps

module cdc_synchronizer (
    input  DEST_CLK,
    input  RESET,
    input  ASYNC_IN,

    output reg SYNC_OUT
);

    reg sync_ff1;

    always @(posedge DEST_CLK or posedge RESET) begin
        if (RESET) begin
            sync_ff1 <= 1'b0;
            SYNC_OUT <= 1'b0;
        end
        else begin
            sync_ff1 <= ASYNC_IN;
            SYNC_OUT <= sync_ff1;
        end
    end

endmodule
