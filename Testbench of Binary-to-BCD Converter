`timescale 1ns/1ps

module tb_binary_to_bcd;

    reg [7:0] BINARY;
    wire [11:0] BCD;

    binary_to_bcd DUT (
        .BINARY(BINARY),
        .BCD(BCD)
    );

    initial begin

        $monitor(
            "Time=%0t | Binary=%d | BCD=%b",
            $time, BINARY, BCD
        );

        BINARY = 8'd0;
        #10;

        BINARY = 8'd9;
        #10;

        BINARY = 8'd15;
        #10;

        BINARY = 8'd25;
        #10;

        BINARY = 8'd50;
        #10;

        BINARY = 8'd99;
        #10;

        BINARY = 8'd125;
        #10;

        BINARY = 8'd255;
        #10;

        $finish;
    end

endmodule
