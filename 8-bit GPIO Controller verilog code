`timescale 1ns/1ps

module gpio_controller (
    input        CLK,
    input        RESET,

    input        WRITE_EN,
    input        READ_EN,

    input  [7:0] DATA_IN,
    input  [7:0] GPIO_IN,

    input  [7:0] DIR,       // 1 = output, 0 = input

    output reg [7:0] GPIO_OUT,
    output reg [7:0] DATA_OUT
);

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            GPIO_OUT <= 8'b0;
            DATA_OUT <= 8'b0;
        end
        else begin

            // Write data to GPIO output register
            if (WRITE_EN) begin
                GPIO_OUT <= DATA_IN;
            end

            // Read GPIO pins
            if (READ_EN) begin
                DATA_OUT <= GPIO_IN;
            end
        end
    end

endmodule
