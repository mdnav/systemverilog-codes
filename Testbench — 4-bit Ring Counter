// tb_ring_counter_4bit.v

`timescale 1ns/1ps

module tb_ring_counter_4bit;

    reg CLK;
    reg RESET;

    wire [3:0] Q;

    // Instantiate Ring Counter
    ring_counter_4bit DUT (
        .CLK(CLK),
        .RESET(RESET),
        .Q(Q)
    );

    // Generate Clock
    always #5 CLK = ~CLK;

    initial begin

        $display("------------------------------");
        $display(" Time | CLK | RESET | Q");
        $display("------------------------------");

        $monitor(" %4t |  %b  |   %b   | %b",
                 $time, CLK, RESET, Q);

        // Initial values
        CLK = 0;
        RESET = 1;

        // Reset counter
        #10;

        // Start counting
        RESET = 0;

        // Run for multiple clock cycles
        #100;

        $display("------------------------------");
        $display("Simulation completed.");

        $finish;

    end

endmodule
