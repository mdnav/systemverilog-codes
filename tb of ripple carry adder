// tb_ripple_carry_adder.v

`timescale 1ns/1ps

module tb_ripple_carry_adder;

    reg [3:0] A;
    reg [3:0] B;
    reg Cin;

    wire [3:0] Sum;
    wire Cout;

    // Instantiate Ripple Carry Adder
    ripple_carry_adder DUT (
        .A(A),
        .B(B),
        .Cin(Cin),
        .Sum(Sum),
        .Cout(Cout)
    );

    initial begin

        $display("---------------------------------------------");
        $display("   A       B    Cin |  Cout     Sum");
        $display("---------------------------------------------");

        $monitor(" %b    %b     %b  |    %b     %b",
                 A, B, Cin, Cout, Sum);

        // Test 1: 0 + 0
        A = 4'b0000;
        B = 4'b0000;
        Cin = 0;
        #10;

        // Test 2: 5 + 3 = 8
        A = 4'b0101;
        B = 4'b0011;
        Cin = 0;
        #10;

        // Test 3: 7 + 2 = 9
        A = 4'b0111;
        B = 4'b0010;
        Cin = 0;
        #10;

        // Test 4: 10 + 5 = 15
        A = 4'b1010;
        B = 4'b0101;
        Cin = 0;
        #10;

        // Test 5: 15 + 1 = 16
        A = 4'b1111;
        B = 4'b0001;
        Cin = 0;
        #10;

        // Test 6: 15 + 15 = 30
        A = 4'b1111;
        B = 4'b1111;
        Cin = 0;
        #10;

        // Test 7: Carry input
        A = 4'b0101;
        B = 4'b0011;
        Cin = 1;
        #10;

        $display("---------------------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
