`timescale 1ns/1ps

module tb_dual_port_ram_16x8;

    reg CLK;

    reg WE_A;
    reg [3:0] ADDR_A;
    reg [7:0] DATA_IN_A;
    wire [7:0] DATA_OUT_A;

    reg WE_B;
    reg [3:0] ADDR_B;
    reg [7:0] DATA_IN_B;
    wire [7:0] DATA_OUT_B;

    dual_port_ram_16x8 DUT (
        .CLK(CLK),

        .WE_A(WE_A),
        .ADDR_A(ADDR_A),
        .DATA_IN_A(DATA_IN_A),
        .DATA_OUT_A(DATA_OUT_A),

        .WE_B(WE_B),
        .ADDR_B(ADDR_B),
        .DATA_IN_B(DATA_IN_B),
        .DATA_OUT_B(DATA_OUT_B)
    );

    always #5 CLK = ~CLK;

    initial begin

        $monitor(
            "Time=%0t | A: WE=%b ADDR=%d IN=%h OUT=%h | B: WE=%b ADDR=%d IN=%h OUT=%h",
            $time,
            WE_A, ADDR_A, DATA_IN_A, DATA_OUT_A,
            WE_B, ADDR_B, DATA_IN_B, DATA_OUT_B
        );

        CLK = 1'b0;

        WE_A = 1'b0;
        WE_B = 1'b0;

        ADDR_A = 4'd0;
        ADDR_B = 4'd0;

        DATA_IN_A = 8'h00;
        DATA_IN_B = 8'h00;

        // Write through Port A
        #5;
        WE_A = 1'b1;
        ADDR_A = 4'd3;
        DATA_IN_A = 8'hAA;

        #10;
        WE_A = 1'b0;

        // Read through Port A
        ADDR_A = 4'd3;
        #10;

        // Write through Port B
        WE_B = 1'b1;
        ADDR_B = 4'd7;
        DATA_IN_B = 8'h55;

        #10;
        WE_B = 1'b0;

        // Read different locations simultaneously
        ADDR_A = 4'd3;
        ADDR_B = 4'd7;

        #10;

        // Write using both ports
        WE_A = 1'b1;
        WE_B = 1'b1;

        ADDR_A = 4'd5;
        DATA_IN_A = 8'h12;

        ADDR_B = 4'd9;
        DATA_IN_B = 8'h34;

        #10;

        WE_A = 1'b0;
        WE_B = 1'b0;

        ADDR_A = 4'd5;
        ADDR_B = 4'd9;

        #10;

        $finish;

    end

endmodule
