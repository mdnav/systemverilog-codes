module crc4_generator (
    input  [7:0] DATA,
    output [3:0] CRC
);

    assign CRC[3] = DATA[7] ^ DATA[6] ^ DATA[4] ^ DATA[3] ^ DATA[0];

    assign CRC[2] = DATA[7] ^ DATA[5] ^ DATA[4] ^ DATA[2] ^ DATA[0];

    assign CRC[1] = DATA[7] ^ DATA[6] ^ DATA[5] ^ DATA[1];

    assign CRC[0] = DATA[6] ^ DATA[5] ^ DATA[4] ^ DATA[0];

endmodule
