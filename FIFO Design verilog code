module fifo #(
    parameter DATA_WIDTH = 8,
    parameter DEPTH = 8
)(
    input CLK,
    input RESET,
    input WRITE_EN,
    input READ_EN,
    input [DATA_WIDTH-1:0] DATA_IN,
    output reg [DATA_WIDTH-1:0] DATA_OUT,
    output FULL,
    output EMPTY
);

    reg [DATA_WIDTH-1:0] memory [0:DEPTH-1];

    reg [3:0] write_ptr;
    reg [3:0] read_ptr;
    reg [4:0] count;

    assign EMPTY = (count == 0);
    assign FULL  = (count == DEPTH);

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            write_ptr <= 0;
            read_ptr  <= 0;
            count     <= 0;
            DATA_OUT  <= 0;
        end
        else begin

            // Write operation
            if (WRITE_EN && !FULL) begin
                memory[write_ptr] <= DATA_IN;
                write_ptr <= write_ptr + 1;
            end

            // Read operation
            if (READ_EN && !EMPTY) begin
                DATA_OUT <= memory[read_ptr];
                read_ptr <= read_ptr + 1;
            end

            // Update count
            case ({WRITE_EN && !FULL, READ_EN && !EMPTY})
                2'b10: count <= count + 1;
                2'b01: count <= count - 1;
                default: count <= count;
            endcase
        end
    end

endmodule
