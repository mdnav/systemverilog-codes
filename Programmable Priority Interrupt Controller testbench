`timescale 1ns/1ps

module tb_programmable_priority_encoder;

    reg CLK;
    reg RESET;

    reg [7:0] IRQ;

    reg [2:0] PRIORITY0;
    reg [2:0] PRIORITY1;
    reg [2:0] PRIORITY2;
    reg [2:0] PRIORITY3;
    reg [2:0] PRIORITY4;
    reg [2:0] PRIORITY5;
    reg [2:0] PRIORITY6;
    reg [2:0] PRIORITY7;

    wire       VALID;
    wire [2:0] IRQ_ID;
    wire [2:0] IRQ_PRIORITY;

    programmable_priority_encoder uut (
        .CLK(CLK),
        .RESET(RESET),

        .IRQ(IRQ),

        .PRIORITY0(PRIORITY0),
        .PRIORITY1(PRIORITY1),
        .PRIORITY2(PRIORITY2),
        .PRIORITY3(PRIORITY3),
        .PRIORITY4(PRIORITY4),
        .PRIORITY5(PRIORITY5),
        .PRIORITY6(PRIORITY6),
        .PRIORITY7(PRIORITY7),

        .VALID(VALID),
        .IRQ_ID(IRQ_ID),
        .IRQ_PRIORITY(IRQ_PRIORITY)
    );

    always #5 CLK = ~CLK;

    initial begin

        CLK   = 0;
        RESET = 1;
        IRQ   = 8'b0;

        // Programmable priorities
        PRIORITY0 = 3'd1;
        PRIORITY1 = 3'd7;
        PRIORITY2 = 3'd3;
        PRIORITY3 = 3'd5;
        PRIORITY4 = 3'd2;
        PRIORITY5 = 3'd6;
        PRIORITY6 = 3'd4;
        PRIORITY7 = 3'd0;

        #12;
        RESET = 0;

        // IRQ2, IRQ5 and IRQ7 active
        // Priorities:
        // IRQ2 = 3
        // IRQ5 = 6
        // IRQ7 = 0
        // Therefore IRQ5 should win.
        #10;
        IRQ = 8'b10100100;

        #10;

        $display("--------------------------------");
        $display("Interrupt Request = %b", IRQ);
        $display("Selected IRQ      = %d", IRQ_ID);
        $display("Priority          = %d", IRQ_PRIORITY);
        $display("Valid             = %b", VALID);
        $display("--------------------------------");

        // Change active interrupts
        // IRQ0 = 1
        // IRQ1 = 7
        // IRQ3 = 5
        // IRQ1 should win.
        #10;
        IRQ = 8'b00001011;

        #10;

        $display("--------------------------------");
        $display("Interrupt Request = %b", IRQ);
        $display("Selected IRQ      = %d", IRQ_ID);
        $display("Priority          = %d", IRQ_PRIORITY);
        $display("Valid             = %b", VALID);
        $display("--------------------------------");

        #20;

        $finish;
    end

    initial begin
        $monitor(
            "Time=%0t | IRQ=%b | VALID=%b | IRQ_ID=%d | PRIORITY=%d",
            $time,
            IRQ,
            VALID,
            IRQ_ID,
            IRQ_PRIORITY
        );
    end

endmodule
