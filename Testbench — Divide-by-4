// tb_frequency_divider_by_4.v

`timescale 1ns/1ps

module tb_frequency_divider_by_4;

    reg CLK;
    reg RESET;

    wire CLK_OUT;

    frequency_divider_by_4 DUT (
        .CLK(CLK),
        .RESET(RESET),
        .CLK_OUT(CLK_OUT)
    );

    always #5 CLK = ~CLK;

    initial begin

        CLK = 0;
        RESET = 1;

        $monitor("Time=%0t | CLK=%b | Count=%b | CLK_OUT=%b",
                 $time, CLK, DUT.count, CLK_OUT);

        #10;
        RESET = 0;

        #200;

        $finish;

    end

endmodule
