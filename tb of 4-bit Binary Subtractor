// tb_binary_subtractor_4bit.v

`timescale 1ns/1ps

module tb_binary_subtractor_4bit;

    reg [3:0] A;
    reg [3:0] B;
    reg Bin;

    wire [3:0] Diff;
    wire Bout;

    // Instantiate 4-bit Binary Subtractor
    binary_subtractor_4bit DUT (
        .A(A),
        .B(B),
        .Bin(Bin),
        .Diff(Diff),
        .Bout(Bout)
    );

    initial begin

        $display("-----------------------------------------------");
        $display("   A       B     Bin |  Diff    Bout");
        $display("-----------------------------------------------");

        $monitor(" %b    %b      %b  |  %b       %b",
                 A, B, Bin, Diff, Bout);

        // 5 - 3 = 2
        A = 4'b0101;
        B = 4'b0011;
        Bin = 0;
        #10;

        // 9 - 4 = 5
        A = 4'b1001;
        B = 4'b0100;
        Bin = 0;
        #10;

        // 15 - 5 = 10
        A = 4'b1111;
        B = 4'b0101;
        Bin = 0;
        #10;

        // 8 - 3 = 5
        A = 4'b1000;
        B = 4'b0011;
        Bin = 0;
        #10;

        // 7 - 7 = 0
        A = 4'b0111;
        B = 4'b0111;
        Bin = 0;
        #10;

        // 3 - 5 = negative result, borrow occurs
        A = 4'b0011;
        B = 4'b0101;
        Bin = 0;
        #10;

        // Test with borrow input
        A = 4'b1000;
        B = 4'b0011;
        Bin = 1;
        #10;

        $display("-----------------------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
