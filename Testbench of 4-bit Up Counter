// tb_up_counter_4bit.v

`timescale 1ns/1ps

module tb_up_counter_4bit;

    reg CLK;
    reg RESET;

    wire [3:0] Q;

    // Instantiate Up Counter
    up_counter_4bit DUT (
        .CLK(CLK),
        .RESET(RESET),
        .Q(Q)
    );

    // Clock generation
    always #5 CLK = ~CLK;

    initial begin

        $display("--------------------------------");
        $display(" Time | CLK | RESET | Q");
        $display("--------------------------------");

        $monitor(" %4t |  %b  |   %b   | %b",
                 $time, CLK, RESET, Q);

        // Initial values
        CLK = 0;
        RESET = 1;

        // Keep counter reset
        #10;

        // Start counting
        RESET = 0;

        // Count
        #100;

        $display("--------------------------------");
        $display("Simulation completed.");

        $finish;

    end

endmodule
