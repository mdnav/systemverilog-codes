`timescale 1ns/1ps

module tb_magnitude_comparator_4bit;

    reg  [3:0] A;
    reg  [3:0] B;

    wire A_GREATER;
    wire A_EQUAL;
    wire A_LESS;

    magnitude_comparator_4bit DUT (
        .A(A),
        .B(B),
        .A_GREATER(A_GREATER),
        .A_EQUAL(A_EQUAL),
        .A_LESS(A_LESS)
    );

    initial begin

        $monitor(
            "Time=%0t | A=%d | B=%d | A>B=%b | A=B=%b | A<B=%b",
            $time, A, B,
            A_GREATER,
            A_EQUAL,
            A_LESS
        );

        // A < B
        A = 4'd3;
        B = 4'd7;
        #10;

        // A > B
        A = 4'd12;
        B = 4'd5;
        #10;

        // A = B
        A = 4'd9;
        B = 4'd9;
        #10;

        // A > B
        A = 4'd15;
        B = 4'd8;
        #10;

        // A < B
        A = 4'd2;
        B = 4'd10;
        #10;

        $finish;

    end

endmodule
