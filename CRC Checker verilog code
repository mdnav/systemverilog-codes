module crc4_checker (
    input  [7:0] DATA,
    input  [3:0] RECEIVED_CRC,
    output       ERROR
);

    wire [3:0] CALCULATED_CRC;

    assign CALCULATED_CRC[3] =
        DATA[7] ^ DATA[6] ^ DATA[4] ^ DATA[3] ^ DATA[0];

    assign CALCULATED_CRC[2] =
        DATA[7] ^ DATA[5] ^ DATA[4] ^ DATA[2] ^ DATA[0];

    assign CALCULATED_CRC[1] =
        DATA[7] ^ DATA[6] ^ DATA[5] ^ DATA[1];

    assign CALCULATED_CRC[0] =
        DATA[6] ^ DATA[5] ^ DATA[4] ^ DATA[0];

    // Compare calculated and received CRC
    assign ERROR = (CALCULATED_CRC != RECEIVED_CRC);

endmodule
