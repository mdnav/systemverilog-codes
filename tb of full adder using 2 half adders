`timescale 1ns/1ps

module tb_full_adder;

    reg A;
    reg B;
    reg Cin;

    wire Sum;
    wire Cout;

    full_adder DUT (
        .A(A),
        .B(B),
        .Cin(Cin),
        .Sum(Sum),
        .Cout(Cout)
    );

    initial begin

        $display("------------------------------------");
        $display(" A B Cin | Sum Cout");
        $display("------------------------------------");

        A = 0; B = 0; Cin = 0; #10;
        A = 0; B = 0; Cin = 1; #10;
        A = 0; B = 1; Cin = 0; #10;
        A = 0; B = 1; Cin = 1; #10;
        A = 1; B = 0; Cin = 0; #10;
        A = 1; B = 0; Cin = 1; #10;
        A = 1; B = 1; Cin = 0; #10;
        A = 1; B = 1; Cin = 1; #10;

        $finish;

    end

endmodule
