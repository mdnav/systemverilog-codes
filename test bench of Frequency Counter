`timescale 1ns/1ps

module tb_frequency_counter;

    reg CLK;
    reg RESET;
    reg INPUT_SIGNAL;

    wire [15:0] COUNT;
    wire READY;

    frequency_counter #(
        .GATE_TIME(20)
    ) DUT (
        .CLK(CLK),
        .RESET(RESET),
        .INPUT_SIGNAL(INPUT_SIGNAL),
        .COUNT(COUNT),
        .READY(READY)
    );

    // Reference clock
    always #5 CLK = ~CLK;

    // Input signal
    always #15 INPUT_SIGNAL = ~INPUT_SIGNAL;

    initial begin

        $monitor(
            "Time=%0t | INPUT=%b | COUNT=%d | READY=%b",
            $time, INPUT_SIGNAL, COUNT, READY
        );

        CLK = 1'b0;
        RESET = 1'b1;
        INPUT_SIGNAL = 1'b0;

        #20;

        RESET = 1'b0;

        #500;

        $finish;

    end

endmodule
