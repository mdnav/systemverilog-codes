module dual_port_ram_16x8 (
    input        CLK,

    // Port A
    input        WE_A,
    input  [3:0]  ADDR_A,
    input  [7:0]  DATA_IN_A,
    output [7:0]  DATA_OUT_A,

    // Port B
    input        WE_B,
    input  [3:0]  ADDR_B,
    input        [7:0] DATA_IN_B,
    output [7:0]  DATA_OUT_B
);

    reg [7:0] MEM [0:15];

    // Port A write
    always @(posedge CLK) begin
        if (WE_A)
            MEM[ADDR_A] <= DATA_IN_A;
    end

    // Port B write
    always @(posedge CLK) begin
        if (WE_B)
            MEM[ADDR_B] <= DATA_IN_B;
    end

    // Asynchronous reads
    assign DATA_OUT_A = MEM[ADDR_A];
    assign DATA_OUT_B = MEM[ADDR_B];

endmodule
