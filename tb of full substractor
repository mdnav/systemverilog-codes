// tb_full_subtractor.v

`timescale 1ns/1ps

module tb_full_subtractor;

    reg A;
    reg B;
    reg Bin;

    wire Diff;
    wire Bout;

    // Instantiate Full Subtractor
    full_subtractor DUT (
        .A(A),
        .B(B),
        .Bin(Bin),
        .Diff(Diff),
        .Bout(Bout)
    );

    initial begin

        $display("--------------------------------------");
        $display(" A B Bin | Diff Borrow");
        $display("--------------------------------------");

        $monitor(" %b %b  %b  |  %b     %b",
                 A, B, Bin, Diff, Bout);

        // 000
        A = 0;
        B = 0;
        Bin = 0;
        #10;

        // 001
        A = 0;
        B = 0;
        Bin = 1;
        #10;

        // 010
        A = 0;
        B = 1;
        Bin = 0;
        #10;

        // 011
        A = 0;
        B = 1;
        Bin = 1;
        #10;

        // 100
        A = 1;
        B = 0;
        Bin = 0;
        #10;

        // 101
        A = 1;
        B = 0;
        Bin = 1;
        #10;

        // 110
        A = 1;
        B = 1;
        Bin = 0;
        #10;

        // 111
        A = 1;
        B = 1;
        Bin = 1;
        #10;

        $display("--------------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
