// tb_half_subtractor.v

`timescale 1ns/1ps

module tb_half_subtractor;

    reg A;
    reg B;

    wire Diff;
    wire Borrow;

    // Instantiate Half Subtractor
    half_subtractor DUT (
        .A(A),
        .B(B),
        .Diff(Diff),
        .Borrow(Borrow)
    );

    initial begin

        $display("--------------------------------");
        $display(" A B | Diff Borrow");
        $display("--------------------------------");

        $monitor(" %b %b |  %b     %b",
                 A, B, Diff, Borrow);

        // Test 1: 0 - 0
        A = 0;
        B = 0;
        #10;

        // Test 2: 0 - 1
        A = 0;
        B = 1;
        #10;

        // Test 3: 1 - 0
        A = 1;
        B = 0;
        #10;

        // Test 4: 1 - 1
        A = 1;
        B = 1;
        #10;

        $display("--------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
