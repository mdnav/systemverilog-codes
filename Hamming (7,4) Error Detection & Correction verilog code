module hamming_74_decoder (
    input  wire [6:0] received,
    output reg [3:0] data,
    output reg [2:0] syndrome,
    output reg error
);

    reg p1, p2, p4;
    reg [6:0] corrected;

    always @(*) begin

        // Calculate syndrome bits
        p1 = received[0] ^ received[2] ^ received[4] ^ received[6];
        p2 = received[1] ^ received[2] ^ received[5] ^ received[6];
        p4 = received[3] ^ received[4] ^ received[5] ^ received[6];

        syndrome = {p4, p2, p1};

        corrected = received;

        // Error detected
        if (syndrome != 3'b000) begin
            error = 1;

            // Correct the erroneous bit
            corrected[syndrome - 1] = ~corrected[syndrome - 1];
        end
        else begin
            error = 0;
        end

        // Extract original data bits
        data[0] = corrected[2];
        data[1] = corrected[4];
        data[2] = corrected[5];
        data[3] = corrected[6];

    end

endmodule
