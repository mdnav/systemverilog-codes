// tb_i2c_master.v

`timescale 1ns/1ps

module tb_i2c_master;

    reg CLK;
    reg RESET;
    reg START;

    reg [6:0] SLAVE_ADDR;
    reg [7:0] DATA_IN;

    wire SCL;
    wire SDA;
    wire BUSY;

    // Instantiate I²C Master
    i2c_master DUT (
        .CLK(CLK),
        .RESET(RESET),
        .START(START),
        .SLAVE_ADDR(SLAVE_ADDR),
        .DATA_IN(DATA_IN),
        .SCL(SCL),
        .SDA(SDA),
        .BUSY(BUSY)
    );

    // Generate clock
    always #5 CLK = ~CLK;

    initial begin

        $display("-----------------------------------------------");
        $display("Time | START | SCL | SDA | BUSY");
        $display("-----------------------------------------------");

        $monitor("%4t |   %b   |  %b  |  %b  |  %b",
                 $time, START, SCL, SDA, BUSY);

        // Initial values
        CLK = 0;
        RESET = 1;
        START = 0;

        SLAVE_ADDR = 7'b1010000;
        DATA_IN = 8'b10101010;

        // Reset
        #10;
        RESET = 0;

        // Start I²C transmission
        #10;
        START = 1;

        #10;
        START = 0;

        // Wait for transmission
        #300;

        $display("-----------------------------------------------");
        $display("Simulation completed.");

        $finish;

    end

endmodule
