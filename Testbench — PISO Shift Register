// tb_piso_shift_register_4bit.v

`timescale 1ns/1ps

module tb_piso_shift_register_4bit;

    reg CLK;
    reg RESET;
    reg LOAD;
    reg [3:0] Parallel_In;

    wire Serial_Out;

    // Instantiate PISO Shift Register
    piso_shift_register_4bit DUT (
        .CLK(CLK),
        .RESET(RESET),
        .LOAD(LOAD),
        .Parallel_In(Parallel_In),
        .Serial_Out(Serial_Out)
    );

    // Generate clock
    always #5 CLK = ~CLK;

    initial begin

        $display("------------------------------------------------");
        $display(" Time | CLK | RESET | LOAD | Parallel_In | Out");
        $display("------------------------------------------------");

        $monitor(" %4t |  %b  |   %b   |  %b   |    %b     |  %b",
                 $time, CLK, RESET, LOAD, Parallel_In, Serial_Out);

        // Initial values
        CLK = 0;
        RESET = 1;
        LOAD = 0;
        Parallel_In = 4'b0000;

        // Reset
        #10;
        RESET = 0;

        // Load parallel data: 1011
        LOAD = 1;
        Parallel_In = 4'b1011;
        #10;

        // Start shifting
        LOAD = 0;

        // Shift out 4 bits
        #10;
        #10;
        #10;
        #10;

        $display("------------------------------------------------");
        $display("Simulation completed.");

        $finish;

    end

endmodule
