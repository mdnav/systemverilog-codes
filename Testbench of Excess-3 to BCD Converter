`timescale 1ns/1ps

module tb_excess3_to_bcd;

    reg  [3:0] EXCESS3;
    wire [3:0] BCD;

    excess3_to_bcd DUT (
        .EXCESS3(EXCESS3),
        .BCD(BCD)
    );

    initial begin

        $monitor(
            "Time=%0t | Excess-3=%b | BCD=%b",
            $time, EXCESS3, BCD
        );

        EXCESS3 = 4'b0011;  // 0
        #10;

        EXCESS3 = 4'b0100;  // 1
        #10;

        EXCESS3 = 4'b0101;  // 2
        #10;

        EXCESS3 = 4'b0110;  // 3
        #10;

        EXCESS3 = 4'b0111;  // 4
        #10;

        EXCESS3 = 4'b1000;  // 5
        #10;

        EXCESS3 = 4'b1001;  // 6
        #10;

        EXCESS3 = 4'b1010;  // 7
        #10;

        EXCESS3 = 4'b1011;  // 8
        #10;

        EXCESS3 = 4'b1100;  // 9
        #10;

        $finish;
    end

endmodule
