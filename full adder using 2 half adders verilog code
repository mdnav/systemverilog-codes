// full_adder_using_half_adders.v

module full_adder (
    input A,
    input B,
    input Cin,
    output Sum,
    output Cout
);

    wire S1;
    wire C1;
    wire C2;

    // First Half Adder
    half_adder HA1 (
        .A(A),
        .B(B),
        .Sum(S1),
        .Carry(C1)
    );

    // Second Half Adder
    half_adder HA2 (
        .A(S1),
        .B(Cin),
        .Sum(Sum),
        .Carry(C2)
    );

    // Final Carry
    assign Cout = C1 | C2;

endmodule


module half_adder (
    input A,
    input B,
    output Sum,
    output Carry
);

    assign Sum = A ^ B;
    assign Carry = A & B;

endmodule
