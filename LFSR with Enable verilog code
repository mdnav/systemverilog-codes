module lfsr_4bit_enable (
    input       CLK,
    input       RESET,
    input       ENABLE,
    output reg [3:0] Q
);

    wire FEEDBACK;

    // Polynomial: x^4 + x^3 + 1
    assign FEEDBACK = Q[3] ^ Q[2];

    always @(posedge CLK or posedge RESET) begin
        if (RESET)
            Q <= 4'b0001;
        else if (ENABLE)
            Q <= {Q[2:0], FEEDBACK};
        else
            Q <= Q;
    end

endmodule
