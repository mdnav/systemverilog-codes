`timescale 1ns/1ps

module tb_keypad_password_lock;

    reg CLK, RESET;
    reg KEY_VALID;
    reg [3:0] KEY;

    wire UNLOCK, ERROR;

    keypad_password_lock uut (
        .CLK(CLK),
        .RESET(RESET),
        .KEY_VALID(KEY_VALID),
        .KEY(KEY),
        .UNLOCK(UNLOCK),
        .ERROR(ERROR)
    );

    always #5 CLK = ~CLK;

    task enter_key;
        input [3:0] key_value;
        begin
            @(negedge CLK);
            KEY = key_value;
            KEY_VALID = 1;

            @(negedge CLK);
            KEY_VALID = 0;
        end
    endtask

    initial begin
        CLK = 0;
        RESET = 1;
        KEY_VALID = 0;
        KEY = 0;

        #20 RESET = 0;

        // Enter correct password: 1234
        enter_key(4'h1);
        enter_key(4'h2);
        enter_key(4'h3);
        enter_key(4'h4);

        #20;

        // Reset before the next attempt
        RESET = 1;
        #10 RESET = 0;

        // Enter incorrect password: 1256
        enter_key(4'h1);
        enter_key(4'h2);
        enter_key(4'h5);
        enter_key(4'h6);

        #20 $finish;
    end

    initial begin
        $monitor(
            "Time=%0t KEY=%h UNLOCK=%b ERROR=%b",
            $time, KEY, UNLOCK, ERROR
        );
    end

endmodule
