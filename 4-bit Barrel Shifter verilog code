module barrel_shifter_4bit (
    input  [3:0] DATA,
    input  [1:0] SHIFT,
    input        LEFT_RIGHT,
    output reg [3:0] RESULT
);

    always @(*) begin

        if (LEFT_RIGHT)
            RESULT = DATA << SHIFT;   // Left shift
        else
            RESULT = DATA >> SHIFT;   // Right shift

    end

endmodule
