module dc_motor_controller (
    input  wire CLK,
    input  wire RESET,
    input  wire FORWARD,
    input  wire REVERSE,

    output reg  IN1,
    output reg  IN2,
    output reg  ENABLE
);

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            IN1    <= 1'b0;
            IN2    <= 1'b0;
            ENABLE <= 1'b0;
        end
        else begin
            case ({FORWARD, REVERSE})

                2'b10: begin
                    // Forward
                    IN1    <= 1'b1;
                    IN2    <= 1'b0;
                    ENABLE <= 1'b1;
                end

                2'b01: begin
                    // Reverse
                    IN1    <= 1'b0;
                    IN2    <= 1'b1;
                    ENABLE <= 1'b1;
                end

                2'b00: begin
                    // Stop
                    IN1    <= 1'b0;
                    IN2    <= 1'b0;
                    ENABLE <= 1'b0;
                end

                2'b11: begin
                    // Brake
                    IN1    <= 1'b1;
                    IN2    <= 1'b1;
                    ENABLE <= 1'b1;
                end

                default: begin
                    IN1    <= 1'b0;
                    IN2    <= 1'b0;
                    ENABLE <= 1'b0;
                end

            endcase
        end
    end

endmodule
