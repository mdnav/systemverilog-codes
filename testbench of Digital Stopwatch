`timescale 1ns/1ps

module tb_digital_stopwatch;

    reg CLK;
    reg RESET;
    reg START;
    reg STOP;

    wire [5:0] SECONDS;
    wire [5:0] MINUTES;
    wire RUNNING;

    digital_stopwatch #(
        .CLK_FREQ(4)
    ) uut (
        .CLK(CLK),
        .RESET(RESET),
        .START(START),
        .STOP(STOP),
        .SECONDS(SECONDS),
        .MINUTES(MINUTES),
        .RUNNING(RUNNING)
    );

    // Clock generation
    initial begin
        CLK = 0;
        forever #5 CLK = ~CLK;
    end

    initial begin

        $monitor(
            "Time=%0t | START=%b | STOP=%b | RUNNING=%b | Time=%02d:%02d",
            $time,
            START,
            STOP,
            RUNNING,
            MINUTES,
            SECONDS
        );

        RESET = 1;
        START = 0;
        STOP  = 0;

        #10;
        RESET = 0;

        // Start stopwatch
        #10;
        START = 1;

        #10;
        START = 0;

        // Allow stopwatch to run
        #200;

        // Stop stopwatch
        STOP = 1;

        #10;
        STOP = 0;

        // Stay stopped
        #50;

        // Start again
        START = 1;

        #10;
        START = 0;

        // Continue counting
        #150;

        // Reset stopwatch
        RESET = 1;

        #10;
        RESET = 0;

        #20;

        $finish;
    end

endmodule
