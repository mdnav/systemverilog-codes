// tb_demux_1to4.v

`timescale 1ns/1ps

module tb_demux_1to4;

    reg D;
    reg S0;
    reg S1;

    wire Y0;
    wire Y1;
    wire Y2;
    wire Y3;

    // Instantiate DEMUX
    demux_1to4 DUT (
        .D(D),
        .S0(S0),
        .S1(S1),
        .Y0(Y0),
        .Y1(Y1),
        .Y2(Y2),
        .Y3(Y3)
    );

    initial begin

        $display("--------------------------------");
        $display(" D S1 S0 | Y0 Y1 Y2 Y3");
        $display("--------------------------------");

        $monitor(" %b  %b  %b  | %b  %b  %b  %b",
                 D, S1, S0, Y0, Y1, Y2, Y3);

        // D = 1, Select Y0
        D = 1;
        S1 = 0;
        S0 = 0;
        #10;

        // D = 1, Select Y1
        D = 1;
        S1 = 0;
        S0 = 1;
        #10;

        // D = 1, Select Y2
        D = 1;
        S1 = 1;
        S0 = 0;
        #10;

        // D = 1, Select Y3
        D = 1;
        S1 = 1;
        S0 = 1;
        #10;

        // D = 0
        D = 0;
        S1 = 0;
        S0 = 0;
        #10;

        $display("--------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
