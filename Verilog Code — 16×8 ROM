// rom_16x8.v

module rom_16x8 (
    input  [3:0] ADDRESS,
    output reg [7:0] DATA_OUT
);

    always @(*) begin
        case (ADDRESS)

            4'b0000: DATA_OUT = 8'b00000000;
            4'b0001: DATA_OUT = 8'b00000001;
            4'b0010: DATA_OUT = 8'b00000010;
            4'b0011: DATA_OUT = 8'b00000011;
            4'b0100: DATA_OUT = 8'b00000100;
            4'b0101: DATA_OUT = 8'b00000101;
            4'b0110: DATA_OUT = 8'b00000110;
            4'b0111: DATA_OUT = 8'b00000111;

            4'b1000: DATA_OUT = 8'b00001000;
            4'b1001: DATA_OUT = 8'b00001001;
            4'b1010: DATA_OUT = 8'b00001010;
            4'b1011: DATA_OUT = 8'b00001011;
            4'b1100: DATA_OUT = 8'b00001100;
            4'b1101: DATA_OUT = 8'b00001101;
            4'b1110: DATA_OUT = 8'b00001110;
            4'b1111: DATA_OUT = 8'b00001111;

            default: DATA_OUT = 8'b00000000;

        endcase
    end

endmodule
