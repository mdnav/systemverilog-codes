`timescale 1ns/1ps

module tb_bcd_to_binary;

    reg  [11:0] BCD;
    wire [7:0] BINARY;

    bcd_to_binary DUT (
        .BCD(BCD),
        .BINARY(BINARY)
    );

    initial begin

        $monitor(
            "Time=%0t | BCD=%b | Binary=%d",
            $time, BCD, BINARY
        );

        BCD = 12'b0000_0000_0000;
        #10;

        BCD = 12'b0000_0000_1001; // 9
        #10;

        BCD = 12'b0000_0001_0101; // 15
        #10;

        BCD = 12'b0000_0010_0101; // 25
        #10;

        BCD = 12'b0000_0101_0000; // 50
        #10;

        BCD = 12'b0000_1001_1001; // 99
        #10;

        BCD = 12'b0001_0010_0101; // 125
        #10;

        BCD = 12'b0010_0101_0101; // 255
        #10;

        $finish;
    end

endmodule
