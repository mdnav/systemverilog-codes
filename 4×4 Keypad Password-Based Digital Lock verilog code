module keypad_password_lock (
    input CLK,
    input RESET,
    input KEY_VALID,
    input [3:0] KEY,
    output reg UNLOCK,
    output reg ERROR
);

    reg [3:0] digit_count;
    reg [15:0] entered_password;

    parameter [15:0] PASSWORD = 16'h1234;

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            digit_count      <= 0;
            entered_password <= 0;
            UNLOCK            <= 0;
            ERROR             <= 0;
        end
        else begin
            if (KEY_VALID) begin
                UNLOCK <= 0;
                ERROR  <= 0;

                entered_password <= {
                    entered_password[11:0], KEY
                };

                if (digit_count == 3) begin
                    digit_count <= 0;

                    if ({entered_password[11:0], KEY} == PASSWORD)
                        UNLOCK <= 1;
                    else
                        ERROR <= 1;
                end
                else begin
                    digit_count <= digit_count + 1'b1;
                end
            end
        end
    end

endmodule
