`timescale 1ns/1ps

module wishbone_slave (
    input        CLK,
    input        RESET,

    input        WB_CYC,
    input        WB_STB,
    input        WB_WE,

    input  [1:0] WB_ADDR,
    input  [7:0] WB_DATA_IN,

    output reg [7:0] WB_DATA_OUT,
    output reg       WB_ACK
);

    reg [7:0] REG0;
    reg [7:0] REG1;
    reg [7:0] REG2;
    reg [7:0] REG3;

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            REG0        <= 8'h00;
            REG1        <= 8'h00;
            REG2        <= 8'h00;
            REG3        <= 8'h00;

            WB_DATA_OUT <= 8'h00;
            WB_ACK      <= 1'b0;
        end
        else begin

            WB_ACK <= 1'b0;

            if (WB_CYC && WB_STB) begin

                // Write operation
                if (WB_WE) begin
                    case (WB_ADDR)
                        2'b00: REG0 <= WB_DATA_IN;
                        2'b01: REG1 <= WB_DATA_IN;
                        2'b10: REG2 <= WB_DATA_IN;
                        2'b11: REG3 <= WB_DATA_IN;
                    endcase
                end

                // Read operation
                else begin
                    case (WB_ADDR)
                        2'b00: WB_DATA_OUT <= REG0;
                        2'b01: WB_DATA_OUT <= REG1;
                        2'b10: WB_DATA_OUT <= REG2;
                        2'b11: WB_DATA_OUT <= REG3;
                    endcase
                end

                WB_ACK <= 1'b1;
            end
        end
    end

endmodule
