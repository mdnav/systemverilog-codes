module axi_stream_master (
    input  wire        CLK,
    input  wire        RESET,

    input  wire        START,
    input  wire [31:0] DATA_IN,
    input  wire        LAST_IN,

    output reg         M_AXIS_TVALID,
    output reg [31:0]  M_AXIS_TDATA,
    output reg         M_AXIS_TLAST,
    input  wire        M_AXIS_TREADY,

    output reg         BUSY,
    output reg         DONE
);

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            M_AXIS_TVALID <= 1'b0;
            M_AXIS_TDATA  <= 32'd0;
            M_AXIS_TLAST  <= 1'b0;
            BUSY          <= 1'b0;
            DONE          <= 1'b0;
        end
        else begin
            DONE <= 1'b0;

            // Start a new transfer
            if (START && !BUSY) begin
                M_AXIS_TDATA  <= DATA_IN;
                M_AXIS_TLAST  <= LAST_IN;
                M_AXIS_TVALID <= 1'b1;
                BUSY          <= 1'b1;
            end

            // Transfer occurs when VALID and READY are both HIGH
            if (M_AXIS_TVALID && M_AXIS_TREADY) begin
                M_AXIS_TVALID <= 1'b0;
                M_AXIS_TLAST  <= 1'b0;
                BUSY          <= 1'b0;
                DONE          <= 1'b1;
            end
        end
    end

endmodule
