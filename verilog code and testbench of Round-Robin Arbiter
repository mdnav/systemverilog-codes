// verilog code 
module round_robin_arbiter (
    input  wire       CLK,
    input  wire       RESET,
    input  wire [3:0] REQUEST,
    output reg  [3:0] GRANT
);

    reg [1:0] pointer;

    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            pointer <= 2'b00;
        end
        else begin
            case (pointer)

                2'b00: begin
                    if (GRANT[0])
                        pointer <= 2'b01;
                    else if (GRANT[1])
                        pointer <= 2'b10;
                    else if (GRANT[2])
                        pointer <= 2'b11;
                    else if (GRANT[3])
                        pointer <= 2'b00;
                end

                2'b01: begin
                    if (GRANT[1])
                        pointer <= 2'b10;
                    else if (GRANT[2])
                        pointer <= 2'b11;
                    else if (GRANT[3])
                        pointer <= 2'b00;
                    else if (GRANT[0])
                        pointer <= 2'b01;
                end

                2'b10: begin
                    if (GRANT[2])
                        pointer <= 2'b11;
                    else if (GRANT[3])
                        pointer <= 2'b00;
                    else if (GRANT[0])
                        pointer <= 2'b01;
                    else if (GRANT[1])
                        pointer <= 2'b10;
                end

                2'b11: begin
                    if (GRANT[3])
                        pointer <= 2'b00;
                    else if (GRANT[0])
                        pointer <= 2'b01;
                    else if (GRANT[1])
                        pointer <= 2'b10;
                    else if (GRANT[2])
                        pointer <= 2'b11;
                end

            endcase
        end
    end

    // Grant logic
    always @(*) begin

        GRANT = 4'b0000;

        case (pointer)

            2'b00: begin
                if (REQUEST[0])
                    GRANT = 4'b0001;
                else if (REQUEST[1])
                    GRANT = 4'b0010;
                else if (REQUEST[2])
                    GRANT = 4'b0100;
                else if (REQUEST[3])
                    GRANT = 4'b1000;
            end

            2'b01: begin
                if (REQUEST[1])
                    GRANT = 4'b0010;
                else if (REQUEST[2])
                    GRANT = 4'b0100;
                else if (REQUEST[3])
                    GRANT = 4'b1000;
                else if (REQUEST[0])
                    GRANT = 4'b0001;
            end

            2'b10: begin
                if (REQUEST[2])
                    GRANT = 4'b0100;
                else if (REQUEST[3])
                    GRANT = 4'b1000;
                else if (REQUEST[0])
                    GRANT = 4'b0001;
                else if (REQUEST[1])
                    GRANT = 4'b0010;
            end

            2'b11: begin
                if (REQUEST[3])
                    GRANT = 4'b1000;
                else if (REQUEST[0])
                    GRANT = 4'b0001;
                else if (REQUEST[1])
                    GRANT = 4'b0010;
                else if (REQUEST[2])
                    GRANT = 4'b0100;
            end

        endcase
    end

endmodule
// testbench `timescale 1ns/1ps

module tb_round_robin_arbiter;

    reg CLK;
    reg RESET;
    reg [3:0] REQUEST;

    wire [3:0] GRANT;

    round_robin_arbiter uut (
        .CLK(CLK),
        .RESET(RESET),
        .REQUEST(REQUEST),
        .GRANT(GRANT)
    );

    initial begin
        CLK = 0;
        forever #5 CLK = ~CLK;
    end

    initial begin

        $monitor(
            "Time=%0t | Request=%b | Grant=%b | Pointer=%d",
            $time,
            REQUEST,
            GRANT,
            uut.pointer
        );

        RESET = 1;
        REQUEST = 4'b0000;

        #10;
        RESET = 0;

        // All requesters request
        REQUEST = 4'b1111;
        #50;

        // Requesters 0 and 2
        REQUEST = 4'b0101;
        #40;

        // Requesters 1 and 3
        REQUEST = 4'b1010;
        #40;

        // Only requester 2
        REQUEST = 4'b0100;
        #30;

        // No requests
        REQUEST = 4'b0000;
        #20;

        $finish;
    end

endmodule
