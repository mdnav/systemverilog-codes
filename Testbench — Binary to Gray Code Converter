`timescale 1ns/1ps

module tb_binary_to_gray;

    reg [3:0] BINARY;
    wire [3:0] GRAY;

    // Instantiate Binary to Gray Converter
    binary_to_gray DUT (
        .BINARY(BINARY),
        .GRAY(GRAY)
    );

    initial begin

        $monitor(
            "Time=%0t | Binary=%b | Gray=%b",
            $time,
            BINARY,
            GRAY
        );

        // Test cases

        BINARY = 4'b0000;
        #10;

        BINARY = 4'b0001;
        #10;

        BINARY = 4'b0010;
        #10;

        BINARY = 4'b0011;
        #10;

        BINARY = 4'b0100;
        #10;

        BINARY = 4'b0101;
        #10;

        BINARY = 4'b0110;
        #10;

        BINARY = 4'b0111;
        #10;

        BINARY = 4'b1000;
        #10;

        BINARY = 4'b1001;
        #10;

        BINARY = 4'b1010;
        #10;

        BINARY = 4'b1011;
        #10;

        BINARY = 4'b1100;
        #10;

        BINARY = 4'b1101;
        #10;

        BINARY = 4'b1110;
        #10;

        BINARY = 4'b1111;
        #10;

        $finish;

    end

endmodule
