// universal_shift_register_4bit.v

module universal_shift_register_4bit (
    input CLK,
    input RESET,
    input [1:0] MODE,
    input Shift_Right_In,
    input Shift_Left_In,
    input [3:0] Parallel_In,
    output reg [3:0] Q
);

    always @(posedge CLK) begin

        if (RESET)
            Q <= 4'b0000;

        else begin

            case (MODE)

                2'b00: Q <= Q;  // Hold

                2'b01: Q <= {Shift_Right_In, Q[3:1]};
                // Shift Right

                2'b10: Q <= {Q[2:0], Shift_Left_In};
                // Shift Left

                2'b11: Q <= Parallel_In;
                // Parallel Load

            endcase

        end

    end

endmodule
