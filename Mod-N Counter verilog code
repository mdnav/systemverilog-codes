module mod_n_counter #(
    parameter N = 10
)(
    input CLK,
    input RESET,
    output reg [3:0] Q
);

    always @(posedge CLK or posedge RESET) begin
        if (RESET)
            Q <= 4'b0000;
        else if (Q == N - 1)
            Q <= 4'b0000;
        else
            Q <= Q + 1'b1;
    end

endmodule
