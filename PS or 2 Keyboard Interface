module ps2_keyboard (
    input  wire       CLK,
    input  wire       RESET,

    input  wire       PS2_CLK,
    input  wire       PS2_DATA,

    output reg [7:0]  SCAN_CODE,
    output reg       DATA_VALID,
    output reg       FRAME_ERROR
);

    reg [3:0]  bit_count;
    reg [10:0] shift_reg;

    reg ps2_clk_d;

    // Detect falling edge of PS/2 clock
    always @(posedge CLK or posedge RESET) begin
        if (RESET) begin
            bit_count   <= 4'd0;
            shift_reg   <= 11'd0;
            SCAN_CODE   <= 8'd0;
            DATA_VALID  <= 1'b0;
            FRAME_ERROR <= 1'b0;
            ps2_clk_d   <= 1'b1;
        end
        else begin
            ps2_clk_d  <= PS2_CLK;
            DATA_VALID <= 1'b0;
            FRAME_ERROR <= 1'b0;

            // PS/2 data is sampled on falling edge
            if (ps2_clk_d && !PS2_CLK) begin

                shift_reg[bit_count] <= PS2_DATA;

                if (bit_count == 4'd10) begin

                    bit_count <= 4'd0;

                    // Check start and stop bits
                    if ((shift_reg[0] == 1'b0) &&
                        (PS2_DATA == 1'b1)) begin

                        SCAN_CODE  <= shift_reg[8:1];
                        DATA_VALID <= 1'b1;

                    end
                    else begin
                        FRAME_ERROR <= 1'b1;
                    end

                end
                else begin
                    bit_count <= bit_count + 1'b1;
                end
            end
        end
    end

endmodule
