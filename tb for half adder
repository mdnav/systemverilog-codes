// tb_half_adder.v

`timescale 1ns/1ps

module tb_half_adder;

    reg A;
    reg B;

    wire Sum;
    wire Carry;

    // Instantiate Half Adder
    half_adder DUT (
        .A(A),
        .B(B),
        .Sum(Sum),
        .Carry(Carry)
    );

    initial begin

        $display("--------------------------------");
        $display(" A B | Sum Carry");
        $display("--------------------------------");

        $monitor(" %b %b |  %b    %b",
                 A, B, Sum, Carry);

        // Test 1
        A = 0;
        B = 0;
        #10;

        // Test 2
        A = 0;
        B = 1;
        #10;

        // Test 3
        A = 1;
        B = 0;
        #10;

        // Test 4
        A = 1;
        B = 1;
        #10;

        $display("--------------------------------");
        $display("Simulation completed.");
        $finish;

    end

endmodule
